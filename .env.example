# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Models (defaults shown)
MEDRAG_EMBED_MODEL=text-embedding-3-small
MEDRAG_CHAT_MODEL=gpt-4o-mini

# Embedding backend: auto | openai | sentence-transformers | hashing
# "auto" uses OpenAI when a key is present, else falls back locally.
MEDRAG_EMBED_BACKEND=auto

# NCBI E-utilities politeness (optional but recommended)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# Storage
MEDRAG_DATA_DIR=data

# --- Privacy / security (see SECURITY.md) ---
# Encrypt the corpus and index at rest with AES-256-GCM.
MEDRAG_ENCRYPT=0
# Passphrase for the above. Leave unset to be prompted without echo — safer,
# since exporting it puts it in your shell history and process environment.
MEDRAG_PASSPHRASE=
# Hard-block every outbound call. Nothing reaches OpenAI or NCBI.
MEDRAG_OFFLINE=0
